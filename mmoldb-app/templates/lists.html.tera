{% import "macros" as macros %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>MMOLDB &mdash; Lists</title>
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="stylesheet" href="/static/lists.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>💽</text></svg>">
</head>
<body>
    <h1 class="main-title card"><a href="{{ index_url }}">MMOLDB</a></h1>

    {{ macros::nav(pages=pages, this_page="Lists") }}

    <section class="card">
        <h1>Balk Reasons</h1>

        {% if balk_reasons %}
        <table>
            {% for r in balk_reasons %}
            <tr><td>{{ r.balk_reason }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No balk reasons yet.
        {% endif %}
    </section>

    <section class="card">
        <h1>Weather</h1>

        <p>Note: A weather can appear multiple times if its description has ever changed.</p>

        {% if weather %}
        <table>
            {% for w in weather %}
            <tr><td>{{ w.emoji }}</td><td>{{ w.name }}</td><td>{{ w.tooltip }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No weather yet.
        {% endif %}
    </section>

    <section class="card">
        <h1>Cheers</h1>

        {% if cheers %}
        <table>
            {% for c in cheers %}
            <tr><td>{{ c.cheer }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No cheers yet.
        {% endif %}
    </section>

    <section class="card">
        <h1>Modifications</h1>

        <p>Note: A modification can appear multiple times if its description has ever changed.</p>

        {% if modifications %}
        <table>
            {% for m in modifications %}
            <tr><td>{{ m.emoji }}</td><td class="nowrap">{{ m.name }}</td><td>{{ m.description }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No modifications yet.
        {% endif %}
    </section>

    <section class="card">
        <h1>Player first names</h1>

        {% if player_first_names %}
        <table>
            {% for n in player_first_names %}
            <tr><td>{{ n }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No players yet.
        {% endif %}
    </section>

    <section class="card">
        <h1>Player last names</h1>

        {% if player_last_names %}
        <table>
            {% for n in player_last_names %}
            <tr><td>{{ n }}</td></tr>
            {% endfor %}
        </table>
        {% else %}
        No players yet.
        {% endif %}
    </section>
</body>
</html>
